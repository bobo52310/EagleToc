---
import Layout from "../layouts/Layout.astro";
const hero = {
  title: "🦅 EagleToc - 鷹眼智慧目錄",
  subtitle: "如老鷹般敏銳地俯瞰全文結構，精準導航任何網站的長篇內容",
  bullets: [
    "自動偵測頁面結構與層級",
    "精準定位當前閱讀位置，一鍵跳段",
    "浮動面板、主題與禪讀模式，專注不打擾",
  ],
};
const features = [
  { icon: "🦅", title: "智慧結構識別", desc: "自動識別標題層級，零設定上手" },
  { icon: "🎯", title: "精準定位導航", desc: "高空俯瞰全文，即點即到" },
  { icon: "🎪", title: "靈活互動面板", desc: "拖拉、縮放、停靠，優雅不干擾" },
  { icon: "🌙", title: "多主題切換", desc: "亮/暗色與海洋、森林等個性主題" },
  { icon: "🧘", title: "禪讀模式", desc: "沈浸式閱讀，專注文字內容" },
  { icon: "⚡", title: "智慧白名單", desc: "支援 *.github.* 萬用字元，自動啟動" },
];
const scenes = [
  { icon: "📚", text: "技術文檔：快速定位 API 參考" },
  { icon: "📖", text: "長篇文章：掌握結構、輕鬆跳轉" },
  { icon: "🎓", text: "學習研究：建立知識架構" },
  { icon: "📝", text: "內容創作：優化章節與佈局" },
];
---

<Layout title="EagleToc - 鷹眼智慧目錄｜自動生成網站目錄，精準導航長文" description="EagleToc 讓你如鷹眼俯瞰全文結構，支援智慧偵測、精準定位、禪讀模式與多主題，提升技術文檔與長篇閱讀效率。">
  <header class="sticky top-0 z-50 bg-surface/90 backdrop-blur border-b border-border">
    <div class="mx-auto max-w-6xl px-6 py-4 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3">
        <img src="/icons/icon32.png" alt="EagleToc" width="24" height="24" class="rounded" />
        <span class="font-semibold text-sm">EagleToc</span>
      </a>
      <nav class="hidden sm:flex items-center gap-6 text-sm text-text-muted">
        <a href="#features" class="hover:text-text">功能</a>
        <a href="#scenes" class="hover:text-text">適用場景</a>
        <a href="https://github.com/your-username/eagle-toc" target="_blank" class="hover:text-text">GitHub</a>
      </nav>
    </div>
  </header>

  <main>
    <!-- Hero -->
    <section class="bg-gradient-to-tr from-brand-start to-brand-end text-white">
      <div class="mx-auto max-w-6xl px-6 py-20 grid md:grid-cols-2 gap-10 items-center">
        <div>
          <h1 class="text-3xl md:text-5xl font-bold leading-tight">{hero.title}</h1>
          <p class="mt-4 text-white/90 md:text-lg">{hero.subtitle}</p>
          <ul class="mt-6 space-y-2 text-white/90">
            {hero.bullets.map((b) => <li>• {b}</li>)}
          </ul>
          <div class="mt-8 flex gap-3">
            <a href="#download" class="inline-flex items-center rounded-lg bg-white text-slate-900 px-4 py-2 text-sm font-semibold shadow hover:opacity-95">立即下載</a>
            <a href="#demo" class="inline-flex items-center rounded-lg bg-white/10 text-white px-4 py-2 text-sm font-semibold ring-1 ring-inset ring-white/30 hover:bg-white/15">觀看示範</a>
          </div>
        </div>
        <div class="hidden md:block">
          <div class="rounded-xl border border-white/20 bg-white/5 p-6 shadow-xl">
            <img src="/icons/icon128.png" alt="EagleToc" class="mx-auto" width="128" height="128" />
            <p class="mt-4 text-center text-white/80 text-sm">智慧目錄面板與搜尋示意</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Features -->
    <section id="features" class="py-16">
      <div class="mx-auto max-w-6xl px-6">
        <h2 class="text-2xl md:text-3xl font-bold">功能特色</h2>
        <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {features.map((f) => (
            <div class="rounded-xl bg-surface p-6 border border-border hover:shadow-sm transition">
              <div class="text-2xl">{f.icon}</div>
              <h3 class="mt-3 font-semibold">{f.title}</h3>
              <p class="mt-2 text-sm text-text-muted">{f.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Scenes -->
    <section id="scenes" class="py-12 bg-surface">
      <div class="mx-auto max-w-6xl px-6">
        <h2 class="text-2xl md:text-3xl font-bold">適用場景</h2>
        <div class="mt-6 grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {scenes.map((s) => (
            <div class="rounded-lg bg-surface-alt p-5 border border-border">
              <div class="text-xl">{s.icon}</div>
              <p class="mt-2 text-sm text-text-muted">{s.text}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section id="download" class="py-16">
      <div class="mx-auto max-w-6xl px-6">
        <div class="rounded-2xl p-10 bg-gradient-to-tr from-brand-start to-brand-end text-white flex flex-col md:flex-row items-center justify-between gap-6">
          <div>
            <h3 class="text-xl md:text-2xl font-semibold">準備好以鷹眼視角閱讀了嗎？</h3>
            <p class="mt-1 text-white/85 text-sm">一鍵安裝，立即展開精準導航。</p>
          </div>
          <div class="flex gap-3">
            <a class="inline-flex items-center rounded-lg bg-white text-slate-900 px-4 py-2 text-sm font-semibold shadow hover:opacity-95" href="#">安裝擴充功能</a>
            <a class="inline-flex items-center rounded-lg bg-white/10 text-white px-4 py-2 text-sm font-semibold ring-1 ring-inset ring-white/30 hover:bg-white/15" href="#demo">觀看示範</a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="py-8 border-t border-border text-center text-xs text-text-muted">
    © {new Date().getFullYear()} EagleToc. All rights reserved.
  </footer>
</Layout>
