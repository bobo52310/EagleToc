---
import "../styles/global.css";
const { title = "EagleToc - 鷹眼智慧目錄", description = "如鷹眼俯瞰全文結構，精準導航長文與技術文檔" } = Astro.props;
---
<!doctype html>
<html lang="zh-Hant">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/icons/icon32.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content="/icons/icon128.png" />
		<title>{title}</title>
	</head>
	<body class="min-h-dvh bg-surface-alt text-text">
		<slot />
	</body>
</html>
